# Install as /etc/zapclub/relay.env with mode 600. Never commit the real file.
RELAY_SECRET_KEY=
RELAY_SUPERADMIN=
RELAY_DOMAIN=relay.zapclub.io
RELAY_PORT=3334
RELAY_SERVICE_URL=wss://relay.zapclub.io

# Persistent state on sunnyhill.
RELAY_DB=/var/lib/zapclub-relay/db
SQLITE_PATH=/var/lib/zapclub-relay/conductor.db
RELAY_BANLIST=/var/lib/zapclub-relay/banned.json
RELAY_LISTENERS=/var/lib/zapclub-relay/listeners.json
RELAY_LEADERBOARD=/var/lib/zapclub-relay/leaderboard.json

# YouTube metadata lookup. Keep the Netscape cookie file readable only by zapclub.
YTDLP_COOKIES=/etc/zapclub/youtube-cookies.txt
XDG_CACHE_HOME=/var/lib/zapclub-relay/.cache

# Admin log API. The systemd unit grants read access through the caddy group.
LOG_API_TOKEN=
CADDY_LOG_PATH=/var/log/caddy/zapclub-access.log

# Optional comma-separated trusted source IPs that bypass relay rate limits.
RELAY_IP_WHITELIST=
