# Imported by /etc/caddy/Caddyfile on sunnyhill as /etc/caddy/zapclub.caddy.

(zapclub_access_log) {
	log {
		output file /var/log/caddy/zapclub-access.log {
			mode 0640
			roll_size 5MiB
			roll_keep 2
			roll_keep_for 336h
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			wrap json
		}
	}
}

zapclub.io {
	import zapclub_access_log
	encode zstd gzip

	# LNURL-pay (LUD-16) + NIP-05 — proxied to lnurlp_proxy on 3335.
	# Must come before the SPA handle block (handle blocks are ordered).
	handle /.well-known/lnurlp/* {
		reverse_proxy 127.0.0.1:3335
	}
	handle /.well-known/nostr.json* {
		reverse_proxy 127.0.0.1:3335
	}

	# YouTube search/playlist proxy → relay (yt-dlp). Same-origin so the frontend
	# avoids CORS; the relay rate-limits these per IP.
	handle /yt-search* {
		reverse_proxy 127.0.0.1:3334
	}
	handle /yt-playlist* {
		reverse_proxy 127.0.0.1:3334
	}

	handle {
		root * /srv/zapclub/current/frontend/dist
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; img-src 'self' data: https:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'"
		-Server
	}
}

relay.zapclub.io {
	import zapclub_access_log
	reverse_proxy 127.0.0.1:3334 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src https://zapclub.io; connect-src 'self' wss://relay.nostr.band wss://nos.lol https:; frame-ancestors 'none'"
	}
}
