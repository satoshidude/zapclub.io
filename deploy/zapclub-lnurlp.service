[Unit]
Description=zapclub.io LNURL and NIP-05 proxy
After=network.target

[Service]
Type=simple
User=zapclub
Group=zapclub
WorkingDirectory=/srv/zapclub/current/deploy
ExecStart=/usr/bin/python3 /srv/zapclub/current/deploy/lnurlp_proxy.py
Restart=on-failure
RestartSec=5

Environment=LNURL_FALLBACK_DOMAIN=nsnip.io
Environment=LNURL_DOMAIN=zapclub.io
Environment=RELAY_PUBLIC_URL=wss://relay.zapclub.io
Environment=PORT=3335

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
